<Project>

  <!--
    Version is owned by the git tag, not by this file. CI derives it from the ref and passes
    /p:Version + /p:InformationalVersion to `dotnet publish` (the Docker build context excludes
    .git, so nothing tag-based can run inside the image build). The value below is only what a
    local `dotnet build` gets, and the -dev suffix is the tell that a binary was not built by CI.
  -->
  <PropertyGroup>
    <Version>0.0.0-dev</Version>
    <Product>Maki</Product>
    <Company>Maki</Company>

    <!--
      The SDK otherwise appends ".<full-sha>" to InformationalVersion of its own accord, which
      would double up the "+<commit>" build metadata CI already sets and leave VersionInfo.Commit
      holding two shas. Turn it off so what CI passes is the authoritative value.
    -->
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!--
    A Debug build with no runtime given targets the machine it runs on, so each output folder gets
    one platform's native libraries instead of every platform's (libvips, ONNX Runtime, SQLite and
    pdfium for Linux, macOS, Android and iOS), which is most of a worktree's size. The output path
    stays the same. Release, CI and anything passing -r are unaffected; -p:MakiAllRuntimes=true
    restores the old layout.
  -->
  <PropertyGroup Condition="'$(Configuration)' != 'Release' And '$(RuntimeIdentifier)' == '' And '$(MakiAllRuntimes)' != 'true'">
    <_MakiHostOs Condition="$([MSBuild]::IsOSPlatform('Windows'))">win</_MakiHostOs>
    <_MakiHostOs Condition="$([MSBuild]::IsOSPlatform('Linux'))">linux</_MakiHostOs>
    <_MakiHostOs Condition="$([MSBuild]::IsOSPlatform('OSX'))">osx</_MakiHostOs>
    <_MakiHostArch>$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture.ToString().ToLowerInvariant())</_MakiHostArch>
    <RuntimeIdentifier Condition="'$(_MakiHostOs)' != ''">$(_MakiHostOs)-$(_MakiHostArch)</RuntimeIdentifier>
    <SelfContained>false</SelfContained>
    <AppendRuntimeIdentifierToOutputPath>false</AppendRuntimeIdentifierToOutputPath>
  </PropertyGroup>

</Project>
