# Sample systemd unit for the Maki Linux tarball. Copy it to /etc/systemd/system/maki.service and
# adjust the paths and user, then: systemctl daemon-reload && systemctl enable --now maki
#
# Restart=always is what brings Maki back after a restore or a restart from Settings: Maki stops
# itself on purpose for both and relies on whatever started it to start it again.
[Unit]
Description=Maki manga collection manager
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=maki
Group=maki
WorkingDirectory=/opt/maki
ExecStart=/opt/maki/Maki.Api
Environment=MAKI_CONFIG_DIR=/var/lib/maki
# The same glibc settings as the Docker image: without them native heap grows with the machine's
# core count, and freed ONNX and libvips buffers stay in the arenas.
Environment=MALLOC_ARENA_MAX=2
Environment=MALLOC_MMAP_THRESHOLD_=131072
Environment=MALLOC_TRIM_THRESHOLD_=131072
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
