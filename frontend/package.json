{
  "name": "frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "check:secure-context": "node ../scripts/frontend/check-secure-context.mjs",
    "preview": "vite preview",
    "i18n:extract": "lingui extract",
    "i18n:sync": "node ../scripts/i18n/sync-server-keys.mjs",
    "i18n:check": "node ../scripts/i18n/sync-server-keys.mjs --check",
    "i18n:todo": "node ../scripts/i18n/todo.mjs",
    "i18n:validate": "node ../scripts/i18n/validate.mjs",
    "i18n:bundle": "node ../scripts/i18n/check-bundle.mjs",
    "ds:build": "node ../scripts/design-system/build.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-storybook": "vitest --project storybook run"
  },
  "dependencies": {
    "@fontsource-variable/bricolage-grotesque": "^5.3.0",
    "@fontsource-variable/onest": "^5.3.1",
    "@lingui/core": "^6.7.0",
    "@lingui/react": "^6.7.0",
    "@mantine/charts": "^9.4.1",
    "@mantine/core": "^9.4.1",
    "@mantine/hooks": "^9.4.1",
    "@mantine/notifications": "^9.4.1",
    "@microsoft/signalr": "^10.0.0",
    "@tabler/icons-react": "^3.44.0",
    "@tanstack/react-query": "^5.101.2",
    "idb": "^8.0.4",
    "motion": "^12.42.2",
    "qrcode": "^1.5.4",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router-dom": "^7.18.2",
    "recharts": "^3.9.2"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@chromatic-com/storybook": "^5.5.1",
    "@lingui/babel-plugin-lingui-macro": "^6.7.0",
    "@lingui/cli": "^6.7.0",
    "@lingui/vite-plugin": "^6.7.0",
    "@messageformat/parser": "^5.1.1",
    "@rolldown/plugin-babel": "^0.2.4",
    "@storybook/addon-a11y": "^10.6.2",
    "@storybook/addon-docs": "^10.6.2",
    "@storybook/addon-mcp": "^10.6.2",
    "@storybook/addon-vitest": "^10.6.2",
    "@storybook/react-vite": "^10.6.2",
    "@types/node": "^24.13.2",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser-playwright": "^5.0.5",
    "@vitest/coverage-v8": "^5.0.5",
    "msw": "^3.0.3",
    "msw-storybook-addon": "^3.0.3",
    "oxlint": "^1.71.0",
    "playwright": "^1.64.1",
    "storybook": "^10.6.2",
    "typescript": "~6.0.2",
    "vite": "^8.1.1",
    "vitest": "^5.0.5"
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
