{
  // Storybook config and its mock fixtures, type-checked against the app's own types so a fixture
  // that drifts from a DTO fails `tsc -b` rather than rendering a half-broken story.
  "extends": "./tsconfig.app.json",
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.storybook.tsbuildinfo",
    "types": ["vite/client", "node"]
  },
  "include": [".storybook", "vitest.config.ts", "vitest.shims.d.ts"],
  "exclude": []
}
