#: src/Maki.Api/Services/DownloadBatchNotifier.cs
msgid "inbox.downloads.finishedWithErrors.title"
msgstr "Downloads finished with errors"

#. The counts that are zero drop out of the sentence through their own =0 branch, so a run that
#. cancelled nothing does not say "0 cancelled". Keep every =0 {} empty. {error} is the source's
#. own wording; {hasError} says whether the run recorded one at all.
#: src/Maki.Api/Services/DownloadBatchNotifier.cs
msgid "inbox.downloads.finishedWithErrors.body"
msgstr ""
"{series}: {completed} downloaded{failed, plural, =0 {} other {, # failed}}"
"{cancelled, plural, =0 {} other {, # cancelled}}"
"{unfinished, plural, =0 {} other {, # unfinished}} of {queued} queued"
"{hasError, select, yes {. First error: {error}} other {}}"

