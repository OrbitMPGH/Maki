#: src/Maki.Api/Controllers/RecommendationFeedbackController.cs
msgid "error.feedback.unknownTitle"
msgstr "Unknown catalogue title"

#: src/Maki.Api/Controllers/RecommendationFeedbackController.cs
msgid "error.feedback.unsupportedAction"
msgstr "Unsupported feedback action"

#. The exposure medium names something other than manga, anime, both or unspecified.
#: src/Maki.Api/Controllers/RecommendationFeedbackController.cs
msgid "error.feedback.unsupportedMedium"
msgstr "Unsupported exposure medium"

#: src/Maki.Api/Controllers/RecommendationFeedbackController.cs
msgid "error.feedback.unsupportedSort"
