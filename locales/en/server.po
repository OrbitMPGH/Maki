#. 500 — ResetAuthenticatorKeyAsync/GetAuthenticatorKeyAsync returned nothing, which is not
#. expected to happen in practice.
#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.authenticatorKeyFailed"
msgstr "Could not generate an authenticator key"

#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.codeRequired"
msgstr "A code from your authenticator app is required"

#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.incorrectPassword"
msgstr "Password is incorrect"

#. The two-factor enrolment code was rejected. Distinct from error.auth.invalidCode, which is the
#. sign-in-time 2FA prompt.
#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.invalidCode"
msgstr "That code is not valid"

#. {ratings} is the comma-separated list of valid content rating codes (ContentRating.All), not
#. translated. Same text as error.users.invalidContentRating but a different caller (a user setting
#. their own ceiling here, an admin setting someone else's there).
#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.invalidContentRating"
msgstr "Rating must be one of: {ratings}"

#. The signed-in user typed their current password wrong too many times.
#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.lockedOut"
msgstr "Too many incorrect password attempts. Try again later."

#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.nameRequired"
msgstr "Name is required"

#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.opdsKeyOnOpdsCard"
msgstr "OPDS feed URLs are created on the OPDS card in Settings"

#. Shared by both SetupTwoFactor and EnableTwoFactor: an account with no working password login
#. (SSO-provisioned, or refused by auth.oidconly) has nothing for a second factor to protect.
#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.noPasswordLogin"
msgstr "Two-factor protects a password sign-in, and this account has none"

#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.passwordsRequired"
msgstr "Current and new password are required"

#: src/Maki.Api/Controllers/AccountController.cs
msgid "error.account.twoFactorAlreadyEnabled"
msgstr "Two-factor authentication is already enabled"

#: src/Maki.Api/Controllers/AnimeSignalsController.cs
msgid "error.animeSignals.disabled"
msgstr "Anime taste signals are switched off on this server"

#: src/Maki.Api/Controllers/AnimeSignalsController.cs
msgid "error.animeSignals.notEnabled"
msgstr "Turn on anime taste signals before syncing"

#: src/Maki.Api/Controllers/AnimeSignalsController.cs
msgid "error.animeSignals.syncRunning"
msgstr "An anime list sync is already running"

#. The CSRF filter's own refusal, shown for any state-changing request missing a valid
#. XSRF-TOKEN/antiforgery cookie pair.
#: src/Maki.Api/Auth/AntiforgeryCookieFilter.cs
msgid "error.auth.antiforgeryTokenInvalid"
msgstr "Invalid or missing antiforgery token"

#. Also shared across several distinct two-factor failures (missing code, expired 2FA cookie,
#. wrong code, locked out at 2FA) for the same enumeration-safety reason as error.auth.signInFailed.
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.invalidCode"
msgstr "Invalid code"

#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.passwordRequired"
msgstr "Password is required"

#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.setupAlreadyCompleted"
msgstr "Setup has already been completed"

#. One message for every login failure on purpose — unknown user, wrong password, disabled
#. account, oidconly refusal, and lockout all answer with this same key. Distinguishing them would
#. let an attacker enumerate valid usernames; see .claude/rules/auth.md.
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.signInFailed"
msgstr "Invalid username or password"

#: src/Maki.Api/Auth/OidcSignInService.cs
msgid "error.auth.ssoAccountDisabled"
msgstr "That account is disabled"

#. The unclaimed placeholder account: only POST auth/setup may claim it.
#: src/Maki.Api/Auth/OidcSignInService.cs
msgid "error.auth.ssoAccountNotSetUp"
msgstr "That account has not been set up yet"

#. Self-service linking (settings page), not the automatic linking a verified email does at
#. sign-in: this subject is already linked to a different Maki account.
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.ssoAlreadyLinkedOther"
msgstr "That single sign-on account is already linked to a different user"

#. The provider's own authorize endpoint refused the request outright (e.g. a bad client id) before
#. any redirect happened.
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.ssoChallengeRejected"
msgstr "The identity provider rejected the sign-in request. Check the OIDC client configuration."

#. The external cookie the OIDC handler deposits was missing or unauthenticated when the callback
#. ran: an expired correlation, a second reload of the callback URL.
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.ssoIncomplete"
msgstr "The sign-in did not complete. Please try again."

#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.ssoLinkFailed"
msgstr "Could not link that single sign-on account"

#: src/Maki.Api/Auth/OidcSignInService.cs
msgid "error.auth.ssoLinkNewAccountFailed"
msgstr "Could not link that login to a new account"

#: src/Maki.Api/Auth/OidcSignInService.cs
msgid "error.auth.ssoNoAccountLinked"
msgstr "No Maki account is linked to that login"

#. Shared by AuthController (the sign-in and link callbacks) and OidcSignInService: the provider's
#. token carried no "sub" claim to identify the account by.
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.ssoNoSubject"
msgstr "The identity provider returned no subject"

#. The generic fallback when a single sign-on failure has neither a catalogue key
#. (OidcSignInResult.ErrorKey) nor text the identity provider library worded itself
#. (OidcSignInResult.RawError, RemoteFailureContext.Failure.Message in AuthServiceCollectionExtensions).
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.ssoSignInFailed"
msgstr "Sign-in failed"

#. A provisioned account collides with an existing local username.
#: src/Maki.Api/Auth/OidcSignInService.cs
msgid "error.auth.ssoUsernameExists"
msgstr "An account with that username already exists"

#. Shown by GET auth/me when the session's own user id no longer resolves to a usable account
#. (e.g. it was deleted or disabled in the moment between the request arriving and this check).
#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.unauthorized"
msgstr "Unauthorized"

#: src/Maki.Api/Controllers/AuthController.cs
msgid "error.auth.usernameRequired"
msgstr "Username is required"

