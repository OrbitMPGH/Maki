#. names. Caught with Enum.IsDefined rather than a bigger allowed-scope list, since Opds already has
#. its own dedicated refusal above.
#. English: That key scope is not valid
#: src/Maki.Api/Controllers/AccountController.cs
#, fuzzy
msgid "error.account.invalidScope"
msgstr "Недопустимая область действия ключа"

#. The signed-in user typed their current password wrong too many times.
#. English: Too many incorrect password attempts. Try again later.
#: src/Maki.Api/Controllers/AccountController.cs
#, fuzzy
msgid "error.account.lockedOut"
msgstr "Слишком много неудачных попыток ввода пароля. Попробуйте позже."

#. English: Name is required
#: src/Maki.Api/Controllers/AccountController.cs
#, fuzzy
msgid "error.account.nameRequired"
msgstr "Требуется имя"

#. English: OPDS feed URLs are created on the OPDS card in Settings
#: src/Maki.Api/Controllers/AccountController.cs
#, fuzzy
msgid "error.account.opdsKeyOnOpdsCard"
msgstr "URL-адреса лент OPDS создаются на карточке OPDS в разделе «Настройки»"

