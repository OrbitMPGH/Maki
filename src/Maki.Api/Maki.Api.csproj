<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <InternalsVisibleTo Include="Maki.Api.Tests" />
  </ItemGroup>

  <!--
    The message catalogs live at the repo root rather than under this project, because the frontend
    reads the same tree: one catalog means a term cannot be translated two different ways on the two
    sides of the wire. Embedded rather than copied so `dotnet publish` needs no path juggling and an
    operator has no half-editable copy sitting beside the binary. Only server.po is taken; the client
    catalogs are Vite's business. Dockerfile copies locales/ into both build stages for this.
  -->
  <ItemGroup>
    <EmbeddedResource Include="..\..\locales\*\server.po">
      <!-- The locale is the folder name, so lift it into the resource name: Maki.Locales.pt-BR.po. -->
      <LogicalName>Maki.Locales.$([System.IO.Path]::GetFileName($([System.IO.Path]::GetDirectoryName('%(FullPath)')))).po</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Maki.Core\Maki.Core.csproj" />
    <ProjectReference Include="..\Maki.Data\Maki.Data.csproj" />
    <ProjectReference Include="..\Maki.Sources\Maki.Sources.csproj" />
    <ProjectReference Include="..\Maki.Metadata\Maki.Metadata.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Karambolo.PO" Version="1.13.0" />
    <PackageReference Include="MessageFormat" Version="8.0.0" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="10.0.9" />
    <PackageReference Include="Microsoft.AspNetCore.SignalR.Client" Version="10.0.9" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.9">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Quartz.Extensions.Hosting" Version="3.18.2" />
    <PackageReference Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!--
    Memory footprint. The Web SDK defaults to Server GC, which spins up one heap per logical CPU
    and holds freed segments aggressively — on a multi-core host that alone parks a self-hosted,
    low-traffic app like this well above 500 MB of RSS. Workstation GC (single heap) plus
    concurrent collection, returning free memory to the OS, and a moderate ConserveMemory setting
    (compact more, trade a little CPU) keep steady state in the 200–300 MB target range.
  -->
  <PropertyGroup>
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
    <RetainVMGarbageCollection>false</RetainVMGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="5" Trim="false" />
  </ItemGroup>

  <!--
    Debug builds rebuild the SPA into wwwroot whenever frontend sources changed, so launching the API
    from an IDE serves the current UI on :8990. Release (CI, Docker) skips it: Docker copies its own
    frontend stage in. Calls vite directly rather than `npm run build` so a frontend type error
    does not block a backend build; CI still runs tsc. Opt out with -p:SkipFrontendBuild=true.

    wwwroot is dropped from Content because static web assets glob it at evaluation, before this
    target swaps the hashed files, and then fail on the old names. UseStaticFiles reads the folder
    from disk, so nothing is lost.
  -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug' And '$(SkipFrontendBuild)' != 'true'">
    <BuildFrontendInDebug>true</BuildFrontendInDebug>
    <FrontendDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'frontend'))</FrontendDir>
    <LocalesDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', '..', '..', 'locales'))</LocalesDir>
    <SpaOutDir>$([MSBuild]::NormalizeDirectory('$(MSBuildThisFileDirectory)', 'wwwroot'))</SpaOutDir>
  </PropertyGroup>

  <ItemGroup Condition="'$(BuildFrontendInDebug)' == 'true'">
    <Content Remove="wwwroot\**" />
    <FrontendInput Include="$(FrontendDir)src\**;$(FrontendDir)public\**;$(LocalesDir)*\client.po" />
    <FrontendInput Include="$(FrontendDir)index.html;$(FrontendDir)package-lock.json;$(FrontendDir)vite.config.ts;$(FrontendDir)lingui.config.js" />
  </ItemGroup>

  <Target Name="BuildFrontend" BeforeTargets="BeforeBuild" Condition="'$(BuildFrontendInDebug)' == 'true'"
          Inputs="@(FrontendInput)" Outputs="$(SpaOutDir)index.html">
    <Warning Condition="!Exists('$(FrontendDir)node_modules')"
             Text="Skipping the SPA build: run `npm ci` in frontend/ first. wwwroot keeps its old contents." />
    <Exec Condition="Exists('$(FrontendDir)node_modules')" WorkingDirectory="$(FrontendDir)"
          Command="npx vite build --outDir &quot;$(SpaOutDir.TrimEnd('\/'))&quot; --emptyOutDir" />
  </Target>

</Project>
