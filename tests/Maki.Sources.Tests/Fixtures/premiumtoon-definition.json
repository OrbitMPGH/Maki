{
  "schema": 1,
  "id": "lanternleaf",
  "name": "Lanternleaf Scans",
  "baseUrl": "https://lanternleaf.example",
  "language": "en",
  "kind": "scanlator",
  "content": ["manhwa"],
  "rating": "general",
  "minIntervalMs": 1000,

  "series": {
    "url": "/series/{seriesId}/",
    "title": { "css": "h1" }
  },

  "chapters": {
    "item": { "css": "li.chapter-row" },
    "id": { "css": "a", "attr": "href", "regex": "^/read/[^/]+/([^/]+)/$" },
    "url": "/read/{seriesId}/{chapterId}/",
    "number": { "css": "span.ch-num" },
    "locked": { "css": "img[src*='coin'], i.icon-lock" },
    "group": { "css": "span.ch-team", "attr": "data-team" }
  },

  "pages": {
    "list": { "css": "div.reader img" }
  },

  "sample": {
    "seriesUrl": "https://lanternleaf.example/series/ember-choir/",
    "chapterUrl": "https://lanternleaf.example/read/ember-choir/chapter-10/"
  }
}
